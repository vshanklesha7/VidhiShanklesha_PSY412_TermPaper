        <Param val="if main_response.keys == str(int(correct_resp)):&amp;#10;    main_corr = 1&amp;#10;else:&amp;#10;    main_corr = 0&amp;#10;&amp;#10;thisExp.addData('main_correct', main_corr)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
